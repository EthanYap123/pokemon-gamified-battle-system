# Copy to .env and fill in. Never commit the real .env.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/pokemon
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional
PORT=3000
JWT_EXPIRES_IN=30m
JWT_ALGORITHM=HS256
# Comma-separated user ids allowed to change gyms, badges and Pokémon (nobody when empty)
ADMIN_USER_IDS=
# Password for the seed trainers (defaults to 1234 locally)
SEED_PASSWORD=
# Postgres pool size per server instance (defaults to 5)
DB_POOL_MAX=
